# hao-code configuration.
# Copy this file to ".env" in the folder you run hao-code from, or export the
# variables in your shell. Precedence: environment > this file's values loaded
# as env > ~/.config/hao-code/config.json > built-in defaults.
# The defaults below are set up for a local Ollama server — no API key needed.

# Which provider to use: "openai-compatible" or "anthropic".
# Leave unset to auto-detect: the config file wins, else Anthropic is chosen
# when ANTHROPIC_API_KEY is set, else the OpenAI-compatible local default.
# AGENT_PROVIDER=openai-compatible

# --- OpenAI-compatible provider (default) ---

# Any OpenAI-compatible endpoint. Default: your local Ollama server.
AGENT_BASE_URL=http://localhost:11434/v1

# Model name served by that endpoint.
AGENT_MODEL=qwen2.5-coder:7b

# Bearer token. Ollama ignores this; set a real key for hosted providers.
# AGENT_API_KEY=ollama

# --- Anthropic provider ---

# Anthropic API key. Just setting this selects the Anthropic provider
# (unless AGENT_PROVIDER or the config file says otherwise).
# ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model (default claude-sonnet-4-5) and endpoint overrides.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Display ---

# Trace mode: after each step, print a structured feed with the tool calls,
# their arguments, and a preview of each result. Same as the --trace flag
# or "trace": true in the config file.
# AGENT_TRACE=1

# Alternatively, keep settings in ~/.config/hao-code/config.json:
# { "provider": "anthropic", "apiKey": "sk-ant-...", "model": "claude-sonnet-4-5", "trace": false }
